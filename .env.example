DEBUG=true
# Host ports for docker-compose.dev.yaml; change if 5432/6379 are taken (keep the URLs below in sync).
POSTGRES_PORT=5432
VALKEY_PORT=6379
SECRET_KEY=dev-insecure-change-me
DATABASE_URL=postgres://organizer:organizer@localhost:5432/organizer
VALKEY_CACHE_URL=redis://localhost:6379/1
VALKEY_BROKER_URL=redis://localhost:6379/0
DEFAULT_FROM_EMAIL=organizer@localhost
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
SITE_URL=http://localhost:9000
# Email provider (see https://anymail.dev). Example for Postmark:
# EMAIL_BACKEND=anymail.backends.postmark.EmailBackend
# ANYMAIL_POSTMARK_SERVER_TOKEN=...
# ANYMAIL_WEBHOOK_SECRET=webhookuser:long-random-password

# Files here replace the app's templates with the same relative path (pages and emails).
# CUSTOM_TEMPLATES_DIR=/path/to/your/templates
