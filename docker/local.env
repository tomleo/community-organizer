# Local run of the production stack. Use with:
#   docker build -t community-organizer:local .
#   docker compose --env-file docker/local.env -f docker-compose.yaml -f docker-compose.local.yaml up -d
APP_ENV_FILE=docker/local.env
BACKUP_ENV_FILE=docker/local-backup.env
IMAGE=community-organizer
VERSION=local
SITE_URL=https://localhost:8443
SECRET_KEY=local-only-a1B2c3D4e5F6g7H8i9J0a1B2c3D4e5F6g7H8i9J0a1B2c3
POSTGRES_PASSWORD=local-only-password
DEFAULT_FROM_EMAIL=organizer@localhost
# Production refuses the console backend; this SMTP host doesn't exist, so mail just fails to send.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.invalid
ADMINS=ops@localhost
SECURE_HSTS_SECONDS=60
