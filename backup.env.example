# Copy to backup.env next to docker-compose.yaml (chmod 600). Only the backup service reads it,
# because these credentials can delete the off-site snapshots.
# Any restic repository; for Backblaze B2's S3 API:
# RESTIC_REPOSITORY=s3:https://s3.us-west-004.backblazeb2.com/your-bucket
# Generate with: openssl rand -hex 32 — and store a copy somewhere other than this server!
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Nightly, in the site's time zone (Manage → Site settings).
BACKUP_TIME=03:00
