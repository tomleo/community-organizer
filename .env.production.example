# Copy to .env next to docker-compose.yaml and fill in. Never commit .env.
# Backup settings go in a separate backup.env (see backup.env.example), read only by the backup service.

# --- Required ---------------------------------------------------------------
# Image to run; VERSION follows a release line (1 = newest 1.x; 1.2 = newest 1.2.x).
# Before 1.0, minor releases may break things, so follow one minor line (e.g. 0.1).
IMAGE=ghcr.io/tomleo/community-organizer
VERSION=0.1
# Public address of the site. Caddy gets an HTTPS certificate for this host.
SITE_URL=https://volunteer.example.org
# Generate with: openssl rand -hex 32
SECRET_KEY=
# Generate with: openssl rand -hex 32  (hex only, so it's safe inside a URL)
POSTGRES_PASSWORD=
DEFAULT_FROM_EMAIL=volunteer@example.org

# --- Email provider (https://anymail.dev). Example for Postmark: -------------
EMAIL_BACKEND=anymail.backends.postmark.EmailBackend
ANYMAIL_POSTMARK_SERVER_TOKEN=
# Protects the delivery-tracking webhook: username:long-random-password
ANYMAIL_WEBHOOK_SECRET=

# --- Error reports ------------------------------------------------------------
# Comma-separated; they receive server-error and backup-failure emails.
ADMINS=it@example.org
# Optional: Sentry or GlitchTip
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0

# --- Optional -----------------------------------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Lower to 3600 while first setting up HTTPS; raise once everything works.
# SECURE_HSTS_SECONDS=31536000
# LOG_LEVEL=INFO
# Host ports for Caddy (default 80 and 443; Let's Encrypt needs those reachable from the internet).
# HTTP_PORT=80
# HTTPS_PORT=443
# Behind Pangolin or Cloudflare Tunnel (docs/deployment.md); HTTP_PORT then defaults to 8080:
# COMPOSE_FILE=docker-compose.yaml:docker-compose.tunnel.yaml
# TRUSTED_PROXY_COUNT=2
